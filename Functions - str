Functions types:
1.string functions
upper
  select empname,upper(empname) from employee;
lower
  select lower(empname) from employee;
substring
  select empname,substr(empname,1,3) from employee; #index starts from 1
right
  select empname,right(empname,3) from employee; #3 characters from right
left
  select empname,left(empname,3) from employee; #3 characters from right
purpose? bank acc numbers, invoice etc.
substring index = breaking point, on what basis
  select email,substring_index(email,'@',1) from employee; #anu@gmail.com => anu
  select email,substring_index(email,'@',-1) from employee;#anu@gmail.com => gmail.com

  select substring_index('2010-09-07','-',-2); #09-07
  select substring_index('2010-09-07','-',2); #2010-09

to remove .com
  select email,substring_index(substring_index(email,'@',1),'.',1)
  from employee where email is not null; #gmail
year function
  select doj,year(doj) from employee where doj is not null;
concat
  select concat(empname,email) from employee; #anuanu@gmail.com
query? 3 chars from left, domain name, year of doj
  select concat(left(empname,3),
  substring_index(substring_index(email,'@',-1),'.',1),year(doj)) from employee
  where email is not null and doj is not null; #rajgmail2009, ramoutlook2010
rpad, lpad
  select empno,lpad(empno,5,'0') from employee; #00003, 00023
  select rpad(empname,10,'*') from employee; #raju######

query? raju@gmail.com -> r***@gmail.com
  select rpad(left(email,1),length(substring_index(email,'@',1)),'*')
  from employee; #r***

  select concat(rpad(left(email,1),
  length(substring_index(email,'@',1)),'*'),
  '@',substring_index(email,'@',-1)) as 'secured_email'
  from employee; #mahesh@gmail.com -> m*****@gmail.com

instr
  select instr(raju@gmail.com); #returns the 1st occurance of something.
  select email,substr(email,instr(email,'@')+1) from from employee; #gmail.com
replace
  select replace('raju@gmail.com','@','-'); replaces @ with -
  select replace('apple','p','*'); a**le;

?query names with 2 H's
  select * from employee where lenght(replace(empname,'h','')) = length(empname)-2; 

?query how many i's
  select empname,length(empname)-length(replace(empname,'i','')) from employee;

